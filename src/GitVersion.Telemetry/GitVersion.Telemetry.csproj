<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <ProjectReference Include="..\GitVersion.Core\GitVersion.Core.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(GitVersionTelemetryCampaignStart)' != ''">
        <AssemblyMetadata Include="TelemetryCampaignStart" Value="$(GitVersionTelemetryCampaignStart)" />
    </ItemGroup>

    <ItemGroup Condition="'$(GitVersionTelemetryProjectKey)' != ''">
        <AssemblyMetadata Include="TelemetryProjectKey" Value="$(GitVersionTelemetryProjectKey)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <InternalsVisibleTo Include="gitversion" />
        <InternalsVisibleTo Include="GitVersion.App.Tests" />
        <InternalsVisibleTo Include="GitVersion.Telemetry.Tests" />
    </ItemGroup>
</Project>
