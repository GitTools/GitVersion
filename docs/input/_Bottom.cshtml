<div class="github-button">
    <a href="https://github.com/GitTools/GitVersion"><i class="fa fa-github"></i> GitHub</a>
</div>
<script src="/assets/js/mermaid-config.js"></script>
<script>
    (() => {
        const initializeMermaid = window.mermaid.initialize.bind(window.mermaid);

        window.mermaid.initialize = (themeConfig) => initializeMermaid({
            ...themeConfig,
            ...window.gitVersionMermaidConfig,
            flowchart: { ...themeConfig?.flowchart, ...window.gitVersionMermaidConfig.flowchart },
            sequence: { ...themeConfig?.sequence, ...window.gitVersionMermaidConfig.sequence }
        });
    })();
</script>
