@{
    List<Tuple<string, string>> pages = new List<Tuple<string, string>>
    {
        Tuple.Create("Documentation", Context.GetLink("docs")),
        Tuple.Create("API", Context.GetLink("api")),
    };
    foreach(Tuple<string, string> p in pages)
    {
        string current = Context.GetLink(Document);
        string active = (current.TrimEnd('/') == p.Item2.TrimEnd('/') || current.StartsWith(p.Item2.TrimEnd('/') + "/")) ? "active" : null;
        <li class="@active"><a href="@p.Item2">@Html.Raw(p.Item1)</a></li>
    }
}
<li class="gv-theme-item"><button type="button" class="gv-theme-toggle" role="switch" aria-checked="false" aria-label="Dark theme" title="Switch theme" data-theme-toggle><i class="fa fa-moon-o gv-theme-moon" aria-hidden="true"></i><i class="fa fa-sun-o gv-theme-sun" aria-hidden="true"></i></button></li>
<li class="gv-github-item"><a href="https://github.com/GitTools/GitVersion" aria-label="GitVersion on GitHub" title="GitVersion on GitHub"><i class="fa fa-github" aria-hidden="true"></i></a></li>
